* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
}

body {
    background-color: #0f1115;
    color: #ffffff;
    line-height: 1.6;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: rgba(15, 17, 21, 0.95);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    border-bottom: 2px solid #d4af37; /* Military Gold Accent */
}

.logo {
    font-size: 1.5rem;
    font-weight: bold;
    letter-spacing: 2px;
    color: #d4af37;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
    align-items: center;
}

.nav-links a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #d4af37;
}

.btn-portal {
    background: #d4af37;
    color: #000 !important;
    padding: 8px 16px;
    border-radius: 4px;
}

/* Hero Section */
.hero {
    height: 100vh;
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1541872703-74c5e44368f9') center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 60px;
}

.hero h1 {
    font-size: 3.5rem;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.tagline {
    font-size: 1.2rem;
    color: #d4af37;
    letter-spacing: 4px;
    margin-bottom: 30px;
}

/* Stats */
.stats-container {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin: 30px 0;
}

.stat-box {
    background: rgba(255, 255, 255, 0.05);
    padding: 15px 25px;
    border-radius: 8px;
    border: 1px solid rgba(212, 175, 55, 0.3);
}

.stat-num {
    display: block;
    font-size: 2rem;
    font-weight: bold;
    color: #d4af37;
}

.stat-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    color: #ccc;
}

/* Buttons */
.hero-btns {
    display: flex;
    gap: 15px;
    justify-content: center;
}

.btn-primary, .btn-secondary {
    padding: 12px 28px;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
    transition: 0.3s;
}

.btn-primary {
    background: #d4af37;
    color: #000;
}

.btn-secondary {
    border: 2px solid #d4af37;
    color: #fff;
}

.btn-primary:hover, .btn-secondary:hover {
    opacity: 0.8;
}

/* Content Sections */
.content-section {
    padding: 80px 10%;
    text-align: center;
}

.alt-bg {
    background-color: #161920;
}

.content-section h2 {
    font-size: 2.2rem;
    margin-bottom: 20px;
    color: #d4af37;
}

/* Command Grid */
.command-grid {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 30px;
}

.card {
    background: #1f242d;
    padding: 25px;
    border-radius: 8px;
    width: 250px;
    border-top: 3px solid #d4af37;
}

.card h3 {
    font-size: 1.1rem;
    margin-bottom: 5px;
}

.rank {
    color: #d4af37;
    font-size: 0.9rem;
    margin-bottom: 10px;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    background: #0a0b0e;
    font-size: 0.85rem;
    color: #777;
}
